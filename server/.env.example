# Required. Must be random and at least 32 characters — the server refuses to
# start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-strong-random-32plus-char-secret

# Optional. Where the SQLite database file is stored. Defaults to
# server/data/vitaltrack.db (git-ignored). Use an absolute path in production.
# DATABASE_PATH=/var/lib/vitaltrack/vitaltrack.db

# Optional. Comma-separated list of allowed CORS origins. Unset allows all
# origins (dev convenience only — set this in production).
# CORS_ORIGIN=https://your-app.com,https://www.your-app.com

PORT=3001
